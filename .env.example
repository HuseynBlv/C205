# Copy to .env.local and fill in for local development.
# None of these are required to run the foundation UI — pages fall back to
# fixtures (dev) or an honest "not configured" state (prod) without them.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not currently used by any app code — every privileged write goes through a
# SECURITY DEFINER Postgres function instead (see supabase/migrations), so
# this key never needs to exist in the Next.js process. Kept here only in
# case a future admin script needs it; if you set it, never import it from
# any file reachable by a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret gating the one-time /admin-setup page (first
# administrator bootstrap). Generate a real random value for anything other
# than local dev, e.g. `openssl rand -hex 32`.
ADMIN_BOOTSTRAP_SECRET=

# --- Transactional email provider (wired up in the notifications step) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- App behavior flags ---
# Fixtures are ALWAYS off in a production build regardless of this value.
# In development, set to "false" to preview real empty/not-configured states
# instead of fixture data.
NEXT_PUBLIC_USE_FIXTURES=true
