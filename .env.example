# Copy to .env.local and fill in for local development.
# None of these are required to run the foundation UI — pages fall back to
# fixtures (dev) or an honest "not configured" state (prod) without them.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not currently used by any app code — every privileged write goes through a
# SECURITY DEFINER Postgres function instead (see supabase/migrations), so
# this key never needs to exist in the Next.js process. Kept here only in
# case a future admin script needs it; if you set it, never import it from
# any file reachable by a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret gating the one-time /admin-setup page (first
# administrator bootstrap). Generate a real random value for anything other
# than local dev, e.g. `openssl rand -hex 32`.
ADMIN_BOOTSTRAP_SECRET=

# --- Transactional email (Step 5 — the send side of the notifications
# feature; supabase/migrations/20260908150000_email_worker.sql is the
# enqueue/claim side) ---
# A Resend API key (resend.com — free tier is enough for Phase 1, sending
# only to your own verified address via the shared onboarding@resend.dev
# sender). src/lib/email/resend.ts is the only thing that reads this.
EMAIL_PROVIDER_API_KEY=
# Must be onboarding@resend.dev until a real sending domain (e.g. a usg.az
# subdomain) is verified in Resend's dashboard — Resend's shared sender.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
# Authorizes GET /api/cron/send-emails itself. Generate with
# `openssl rand -hex 32`. Named to match Vercel Cron's own convention —
# when this is set, Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` when it calls the route on the
# schedule in vercel.json, so no external scheduler is needed there.
# Deploying elsewhere needs your own scheduler sending that same header.
CRON_SECRET=
# Authorizes the claim_pending_emails/mark_email_sent/mark_email_failed
# database functions those calls make — a second, separate secret (never
# reuse CRON_SECRET here) because those functions are reachable with just
# the public anon key and need their own protection regardless of this
# route. Set once via `select set_email_worker_secret('...');` as an
# authenticated admin (Supabase SQL editor, or psql), then put the exact
# same value here.
EMAIL_WORKER_SECRET=

# --- App behavior flags ---
# Fixtures are ALWAYS off in a production build regardless of this value.
# In development, set to "false" to preview real empty/not-configured states
# instead of fixture data.
NEXT_PUBLIC_USE_FIXTURES=true
