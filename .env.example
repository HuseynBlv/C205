# Copy to .env.local and fill in for local development.
# None of these are required to run the foundation UI — pages fall back to
# fixtures (dev) or an honest "not configured" state (prod) without them.

# --- Supabase (wired up in the database/auth step) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional email provider (wired up in the notifications step) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- App behavior flags ---
# Fixtures are ALWAYS off in a production build regardless of this value.
# In development, set to "false" to preview real empty/not-configured states
# instead of fixture data.
NEXT_PUBLIC_USE_FIXTURES=true
